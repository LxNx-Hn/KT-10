# 저장소 루트 — 공통 무시 항목. (frontend/, backend/ 는 각자 .gitignore 보유)
.DS_Store
*.log
*.local
.venv/
**/.venv/

# AI 도구 로컬 파일
.claude/
claude/
claude-preview/
.claude.json
.claude.local.json

# 환경 변수
.env
.env.local
.env.production
**/.env
!**/.env.example

# 에디터/OS
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Python
__pycache__/
*.py[cod]

# ai/ 파이프라인 캐시 및 모델 산출물 (재생성 가능 — data/raw/ 원본은 git 추적 유지)
ai/data/cache/
ai/data/rankers.pkl
ai/data/rankers*.zip
ai/data/rankers*.metadata.json
ai/data/training/generated/

# OSMnx 기본 HTTP 응답 캐시 (저장소 루트 기준 실행 시 자동 생성)
/cache/
