# 저장소 루트 참고용 예시 — 실제로는 각 하위 프로젝트(frontend/, backend/, ai/)의
# .env.example을 각자 복사해서 사용하세요. 이 파일은 전체 키 목록 참고용입니다.

# ============================================================
# 지도 API 키
# ============================================================

# 카카오맵 JavaScript 키 (브라우저 지도 렌더링 + services 장소검색)
# 발급: https://developers.kakao.com → 앱 생성 → 플랫폼 키
VITE_KAKAO_MAP_KEY=
# REST API 키 (백엔드 장소검색 + Kakao 로그인). JavaScript 키와 별도입니다.
KAKAO_REST_API_KEY=

# Google Maps (비교 검토용 — 필수 아님)
GOOGLE_MAPS_API_KEY=

# 네이버 지도 (비교 검토용 — 필수 아님)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================================
# 경로 수집 API 키 (ai/ 파이프라인)
# ============================================================

# ODsay 대중교통 경로 API (오프라인 수집·호환 설정용, 운영 순위에서 제외)
# 발급: https://lab.odsay.com → 회원가입 → API 키 발급
ODSAY_API_KEY=
# ODsay 30회 외부 한도에서 1회를 남기는 신규 network 호출 hard cap
ODSAY_DAILY_BUDGET=29
# 아래 hedge 설정은 TRANSIT_PROVIDER_ORDER=odsay,tmap을 명시한
# 호환 환경에서만 사용한다. 운영 기본 TMAP에서는 적용되지 않는다.
TRANSIT_PROVIDER_HEDGE_SECONDS=2
TRANSIT_PROVIDER_TOTAL_TIMEOUT_SECONDS=10
TRANSIT_WALK_ENRICHMENT_TIMEOUT_SECONDS=2.5
ROUTE_COLLECTION_TOTAL_TIMEOUT_SECONDS=11

# TMAP 보행자 길찾기 + 통합 대중교통 API
# 같은 appKey에 TMAP 대중교통 상품과 경로안내 상품을 연결합니다.
# 발급: https://openapi.sk.com → 앱 등록 → 상품 연결
TMAP_API_KEY=
ORS_API_KEY=
# 공공데이터포털 일반 인증키(Decoding): 도시철도 시간표·편의시설 공용
DATA_GO_KR_SERVICE_KEY=
TRANSIT_PROVIDER_ORDER=tmap
TMAP_TRANSIT_CACHE_DIR=
TMAP_TRANSIT_CACHE_TTL_SECONDS=1800
TMAP_TRANSIT_TIMEOUT_SECONDS=12
TMAP_TRANSIT_MAX_CANDIDATES=10
TMAP_TRANSIT_MAX_CONCURRENT_REQUESTS=3
BUS_SERVICE_KEY=
BIMS_CACHE_TTL_SECONDS=1800
BIMS_TIMEOUT_SECONDS=12
BIMS_MAX_CONCURRENT_REQUESTS=2
BIMS_MAX_CANDIDATES=10
BIMS_WALK_SPEED_M_PER_MIN=80
