# 저장소 루트 참고용 예시 — 실제로는 각 하위 프로젝트(frontend/, backend/, ai/)의
# .env.example을 각자 복사해서 사용하세요. 이 파일은 전체 키 목록 참고용입니다.

# ============================================================
# 지도 API 키
# ============================================================

# 카카오맵 (지도 렌더링 + 장소 검색 + 주소-좌표 변환)
# 발급: https://developers.kakao.com → 앱 생성 → 플랫폼 키
VITE_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# Google Maps (비교 검토용 — 필수 아님)
GOOGLE_MAPS_API_KEY=

# 네이버 지도 (비교 검토용 — 필수 아님)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================================
# 경로 수집 API 키 (ai/ 파이프라인)
# ============================================================

# ODsay 대중교통 경로 API (메인 경로 수집 소스)
# 발급: https://lab.odsay.com → 회원가입 → API 키 발급
ODSAY_API_KEY=

# TMAP 보행자 길찾기 API (보조 소스 — 계단/엘리베이터 상세 정보)
# 발급: https://openapi.sk.com → TMAP → 앱 등록
TMAP_API_KEY=
