# Kakao Map JavaScript 키 (없으면 mock 지도 패널로 자동 폴백)
# https://developers.kakao.com -> 내 애플리케이션 -> JavaScript 키
VITE_KAKAO_MAP_KEY=

# 데이터 소스 모드: mock | live  (기본 mock)
# live = Python FastAPI 백엔드(backend/)에 연결
VITE_DATA_SOURCE=mock

# live 모드일 때 백엔드 베이스 URL (기본 http://localhost:8000)
VITE_API_BASE=http://localhost:8000
