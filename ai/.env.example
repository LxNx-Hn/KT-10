# ai/.env 로 복사해서 사용하세요. 키가 없는 공급자는 명시적으로 미설정 처리되며
# 가짜 직선/0분 경로를 만들지 않습니다. OSMnx 보행 후보만 키 없이 동작합니다.

# ODsay 대중교통 경로 API (메인)
# 발급: https://lab.odsay.com → 회원가입 → API 키 발급
ODSAY_API_KEY=

# TMAP 보행자 길찾기 API (보조 — 계단/엘리베이터 상세 정보)
# 발급: https://openapi.sk.com → TMAP → 앱 등록
TMAP_API_KEY=

# 기본은 실제 사용자 라벨 검증 모델. LLM judge 데모 모델을 명시적으로
# 제공할 때만 judge_baseline으로 바꾸며 운영 모델로 자동 승격되지 않습니다.
RANKER_TIER=human_validated
