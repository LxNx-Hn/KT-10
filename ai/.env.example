# ai/.env 로 복사해서 사용하세요. 키가 없는 공급자는 명시적으로 미설정 처리되며
# 가짜 0분 경로를 만들지 않습니다. 보행 상세 geometry가 없으면 두 끝점을
# estimated로 명시하며, 느린 OSMnx 복구는 기본적으로 비활성화됩니다.

# ODsay 대중교통 경로 API (메인)
# 발급: https://lab.odsay.com → 회원가입 → API 키 발급
ODSAY_API_KEY=
ODSAY_CACHE_DIR=
ODSAY_CACHE_TTL_SECONDS=1800
ODSAY_TIMEOUT_SECONDS=20
ODSAY_MAX_CANDIDATES=10
# AI 프로세스 전체의 ODsay HTTP 동시 요청 상한(search+loadLane, 1~10)
ODSAY_MAX_CONCURRENT_REQUESTS=3
# 이 서비스가 관측한 일일 ODsay network 호출 운영 경고 기준
ODSAY_DAILY_BUDGET=1000
ELEVATION_CACHE_DIR=
ELEVATION_REGIONAL_DEM_PATH=
ELEVATION_CACHE_TTL_SECONDS=2592000
# 운영 live는 false 유지: 지역 DEM 누락 시 원격 COG·Open-Meteo로 대체하지 않고
# 경사 미확인으로 응답합니다. 배치 수집 컨테이너만 명시적으로 true를 사용합니다.
ELEVATION_NETWORK_FALLBACK_ENABLED=false
ROUTE_FEATURE_CACHE_DIR=
ROUTE_FEATURE_CACHE_TTL_SECONDS=1800

# TMAP 보행자 길찾기 API (보조 — 계단/엘리베이터 상세 정보)
# 발급: https://openapi.sk.com → TMAP → 앱 등록
TMAP_API_KEY=
TMAP_CACHE_DIR=
TMAP_CACHE_TTL_SECONDS=1800
TMAP_MAX_CONCURRENT_REQUESTS=3

# ODsay 보행 구간을 OSM 보행망으로 복구할 때만 true.
# 외부 그래프 조회가 느릴 수 있어 운영 기본값은 false입니다.
OSMNX_WALK_GEOMETRY_ENABLED=false
# Overpass HTTP 요청과 보행 구간 하나의 전체 계산 상한(초).
OSMNX_OVERPASS_URL=https://lambert.openstreetmap.de/api
OSMNX_REQUEST_TIMEOUT_SECONDS=12
OSMNX_WALK_GEOMETRY_TIMEOUT_SECONDS=15

# 기본은 실제 사용자 라벨 검증 모델. 초기 평가 baseline을 명시적으로
# 비교할 때만 bootstrap_baseline으로 바꾸며 운영 모델로 자동 승격되지 않습니다.
RANKER_TIER=human_validated
