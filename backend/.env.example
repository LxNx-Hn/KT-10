# 백엔드 환경변수 예시. 복사해서 backend/.env 로 사용하세요.
# 데모 데이터와 실경로/학습모델의 상태는 화면과 API에서 구분됩니다.
APP_ENV=development

# Kakao 장소검색 REST 키 (https://developers.kakao.com → REST API 키)
# 설정 시 /api/places/search 가 실제 Kakao 결과를 반환합니다. (서버 전용, 클라이언트 비노출)
KAKAO_REST_API_KEY=

# OpenWeather 키 — 현재 날씨와 Air Pollution API의 부산 실측 사용
OPENWEATHER_API_KEY=

# 공공데이터포털 부산버스정보시스템 일반 인증키(Decoding)를 사용
BUS_SERVICE_KEY=

# 호환용 서버 키. 운영 live 후보 수집은 AI_SERVER_URL의 ai 서비스가 ODsay를 호출합니다.
ODSAY_API_KEY=

# 경로 공급 모드. demo=검증된 고정 OD, live=AI 서버의 실제 후보+규칙 비교,
# ai=AI 서버의 학습 모델 순위화
# 키가 있더라도 이 값을 바꾸기 전에는 자동으로 실데이터 모드가 되지 않습니다.
ROUTE_MODE=demo

# 그늘용 건물 공급자. demo는 ROUTE_MODE=demo 고정 OD에서만 사용하며,
# live 경로의 공공 건물 그늘은 vworld=LT_C_BLDGINFO WFS를 선택합니다.
BUILDING_SOURCE=demo
VWORLD_API_KEY=
VWORLD_API_DOMAIN=http://localhost:8002

# ai/ 파이프라인 서버 URL. live/ai 모두 후보 수집 뒤 백엔드에서 그늘을
# 결합하고, ai 모드는 내부 /rank/candidates로 선택한 model tier를 적용합니다.
# 예: http://localhost:8001
AI_SERVER_URL=

# PostgreSQL. Compose의 호스트 포트는 5433입니다.
# 예: postgresql+psycopg://kt10:kt10-local-only@localhost:5433/kt10
# 비어 있으면 로그인·리뷰·개인화 API는 503으로 명시적으로 응답합니다.
DATABASE_URL=

# 카카오 로그인 서버 설정. REST 키는 위 KAKAO_REST_API_KEY를 함께 사용합니다.
SESSION_SECRET=
# 비용이 큰 학습 후보 API 전용 32자 이상 내부 토큰
LABELING_API_TOKEN=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8002/api/auth/kakao/callback
FRONTEND_URL=http://localhost:5173

# 동의 후기 익명화 내보내기 전용. 운영 SESSION_SECRET과 다른 16자 이상 난수 사용.
TRAINING_ANONYMIZATION_SALT=

# CORS 허용 오리진(콤마 구분)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# 외부 API 타임아웃(초)
REQUEST_TIMEOUT=4.0

# 2026-07-23 승인된 초기 파일럿 개인화 정책입니다.
# 후기가 쌓이면 사용자별 영향이 최대 35%까지 완만히 증가합니다.
# 전역 모델은 자동 갱신하지 않고 관리자 승인 학습만 허용합니다.
PERSONALIZATION_LEARNING_RATE=0.25
PERSONALIZATION_REGULARIZATION=0.02
PERSONALIZATION_MAX_SHARE=0.35
PERSONALIZATION_PRIOR_REVIEWS=5
PERSONALIZATION_USABLE_WEIGHT=0.45
PERSONALIZATION_RATING_WEIGHT=0.35
PERSONALIZATION_REUSE_WEIGHT=0.20
