# 백엔드 환경변수 예시. 복사해서 backend/.env 로 사용하세요.
# 키를 비워두면 해당 소스는 자동으로 mock(부산진구 데모)으로 동작합니다.

# Kakao 장소검색 REST 키 (https://developers.kakao.com → REST API 키)
# 설정 시 /api/places/search 가 실제 Kakao 결과를 반환합니다. (서버 전용, 클라이언트 비노출)
KAKAO_REST_API_KEY=

# OpenWeather 키 (https://openweathermap.org/api) — 설정 시 부산진구 실시간 날씨 사용
OPENWEATHER_API_KEY=

# 공공데이터포털 저상버스 도착 서비스키 (정류장 데이터셋 매핑 필요 — README 참고)
BUS_SERVICE_KEY=

# ODsay 대중교통 경로 API 키. 설정 시 실제 버스·지하철 후보를 조회합니다.
ODSAY_API_KEY=

# PostgreSQL. 예: postgresql+psycopg://user:password@localhost:5432/kt10
# 비어 있으면 로그인·리뷰·개인화 API는 503으로 명시적으로 응답합니다.
DATABASE_URL=

# 카카오 로그인 서버 설정. REST 키는 위 KAKAO_REST_API_KEY를 함께 사용합니다.
SESSION_SECRET=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
FRONTEND_URL=http://localhost:5173

# CORS 허용 오리진(콤마 구분)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# 외부 API 타임아웃(초)
REQUEST_TIMEOUT=4.0
