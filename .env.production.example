# 단일 배포 환경파일 예시.
# `python scripts/prepare_deployment_env.py --import-existing` 실행 후
# 외부 서비스 키만 채우고 `--check`로 검증하세요.

PUBLIC_ORIGIN=https://your-domain.example
PORT=8080

# 운영 공급자 선택
ROUTE_MODE=live
BUILDING_SOURCE=vworld

# 외부 서비스 키
VITE_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
ODSAY_API_KEY=
TMAP_API_KEY=
VWORLD_API_KEY=
OPENWEATHER_API_KEY=
BUS_SERVICE_KEY=

# 아래 3개는 준비 스크립트가 안전한 난수로 자동 생성합니다.
POSTGRES_PASSWORD=
SESSION_SECRET=
TRAINING_ANONYMIZATION_SALT=

# 필요할 때만 조정
REQUEST_TIMEOUT=8
