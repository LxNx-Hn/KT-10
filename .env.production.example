# 단일 배포 환경파일 예시.
# `python scripts/prepare_deployment_env.py --import-existing` 실행 후
# 외부 서비스 키만 채우고 `--check`로 검증하세요.

PUBLIC_ORIGIN=https://your-domain.example
# 같은 호스트의 TLS reverse proxy만 접근하도록 기본값을 유지하세요.
# 사설 Load Balancer가 직접 접근할 때만 방화벽 확인 후 0.0.0.0을 사용합니다.
BIND_ADDRESS=127.0.0.1
PORT=8080

# 운영 공급자 선택
ROUTE_MODE=live
BUILDING_SOURCE=vworld

# 외부 서비스 키
# JavaScript 키는 브라우저 지도/장소 SDK용이고 REST 키는 서버 장소검색·로그인용입니다.
# 서로 대체할 수 없습니다.
VITE_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
ODSAY_API_KEY=
ODSAY_CACHE_TTL_SECONDS=1800
ODSAY_TIMEOUT_SECONDS=20
ODSAY_MAX_CANDIDATES=10
# AI 프로세스 전체의 ODsay HTTP 동시 요청 상한(search+loadLane, 1~10)
ODSAY_MAX_CONCURRENT_REQUESTS=3
# 이 서비스가 관측한 일일 ODsay network 호출 운영 경고 기준(70/80/90/100%)
ODSAY_DAILY_BUDGET=1000
ELEVATION_CACHE_TTL_SECONDS=2592000
ROUTE_FEATURE_CACHE_TTL_SECONDS=1800
TMAP_API_KEY=
TMAP_CACHE_TTL_SECONDS=1800
TMAP_MAX_CONCURRENT_REQUESTS=3
# true이면 준비된 ai/data/cache/osmnx/busan-walk.graphml을 보행 geometry fallback으로 사용합니다.
OSMNX_WALK_GEOMETRY_ENABLED=false
OSMNX_OVERPASS_URL=https://lambert.openstreetmap.de/api
OSMNX_REQUEST_TIMEOUT_SECONDS=12
OSMNX_WALK_GEOMETRY_TIMEOUT_SECONDS=15
# human_validated(기본) 또는 명시적 비교용 bootstrap_baseline
RANKER_TIER=human_validated
VWORLD_API_KEY=
VWORLD_CACHE_TTL_HOURS=168
SHADE_CACHE_TTL_SECONDS=86400
OPENWEATHER_API_KEY=
BUS_SERVICE_KEY=

# 아래 4개는 준비 스크립트가 안전한 난수로 자동 생성합니다.
POSTGRES_PASSWORD=
SESSION_SECRET=
TRAINING_ANONYMIZATION_SALT=
LABELING_API_TOKEN=

# 필요할 때만 조정
REQUEST_TIMEOUT=8
WEATHER_CACHE_TTL_SECONDS=300
# 그늘 계산이 현재 날씨 관측을 유효하다고 볼 시간 창(초, 0=판정 불가).
# 관측 나이와 출발시각 차이에 모두 적용한다. 위 캐시 수명과는 다른 값이다.
SHADE_WEATHER_OBSERVATION_VALIDITY_SECONDS=3600
MAX_SUPPORTED_TOTAL_WALK_M=15000
# 요청 body에 topN이 없을 때 적용하는 운영 기본 추천 후보 수(1~10).
# 변경은 서비스 재시작 후 새 검색부터 적용되며 기존 route-set에는 소급되지 않습니다.
ROUTE_DEFAULT_TOP_N=5

# Backend와 AI가 공유하는 내부 API 인증 토큰(최소 32자)
AI_INTERNAL_SERVICE_TOKEN=
