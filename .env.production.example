# 단일 배포 환경파일 예시.
# `python scripts/prepare_deployment_env.py --import-existing` 실행 후
# 외부 서비스 키만 채우고 `--check`로 검증하세요.

PUBLIC_ORIGIN=https://your-domain.example
# 같은 호스트의 TLS reverse proxy만 접근하도록 기본값을 유지하세요.
# 사설 Load Balancer가 직접 접근할 때만 방화벽 확인 후 0.0.0.0을 사용합니다.
BIND_ADDRESS=127.0.0.1
PORT=8080

# 운영 공급자 선택
ROUTE_MODE=ai
BUILDING_SOURCE=vworld

# 외부 서비스 키
# JavaScript 키는 브라우저 지도/장소 SDK용이고 REST 키는 서버 장소검색·로그인용입니다.
# 서로 대체할 수 없습니다.
VITE_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
# 회원 탈퇴 시 카카오 연결 끊기에 쓰는 앱 어드민 키(REST 키와 다른 값).
# 비워 두면 우리 DB만 정리하고 사용자의 카카오 "연결된 서비스"에는 앱이 남습니다.
KAKAO_ADMIN_KEY=
# 탈퇴 기록의 분리 보관기간(일). 계정·프로필·서비스 데이터는 탈퇴 즉시
# 삭제되고, 부정 이용 방지에 필요한 최소 정보만 이 기간 동안 남습니다.
# 기한이 지난 기록은 scripts/purge_withdrawn_users.py가 삭제합니다.
WITHDRAWAL_RETENTION_DAYS=30
# 반복 탈퇴 판별용 해시 salt. 회원번호를 그대로 남기지 않기 위해 사용합니다.
# prepare_deployment_env.py가 자동 생성하므로 손으로 채우지 마세요.
# 한 번 정하면 바꾸지 않습니다. 바꾸면 기존 해시와 대조가 끊깁니다.
WITHDRAWAL_HASH_SALT=
# 이용기록(추천 표시 기록) 보유기간(일). 계정이 살아 있어도 이 기간이 지나면
# scripts/purge_expired_usage_logs.py가 파기합니다. 0은 자동 파기 안 함.
USAGE_LOG_RETENTION_DAYS=365
ODSAY_API_KEY=
TRANSIT_PROVIDER_ORDER=odsay,tmap
# 공공데이터포털 인증키는 URL Decoding 키를 우선 사용합니다. `DECO`는
# AI와 Backend 서버에만 주입됩니다. INCO는 보관용이며 런타임에서 사용하지
# 않습니다. 기존 DATA_GO_KR_SERVICE_KEY는 이관 중인 환경의 fallback입니다.
DECO=
INCO=
DATA_GO_KR_SERVICE_KEY=
ODSAY_CACHE_TTL_SECONDS=1800
ODSAY_TIMEOUT_SECONDS=20
ODSAY_MAX_CANDIDATES=10
# AI 프로세스 전체의 ODsay HTTP 동시 요청 상한(search+loadLane, 1~10)
ODSAY_MAX_CONCURRENT_REQUESTS=3
# ODsay 30회 외부 한도에서 1회를 남기는 신규 network 호출 hard cap
ODSAY_DAILY_BUDGET=29
ELEVATION_CACHE_TTL_SECONDS=2592000
ROUTE_FEATURE_CACHE_TTL_SECONDS=1800
TMAP_API_KEY=
TMAP_CACHE_TTL_SECONDS=1800
TMAP_MAX_CONCURRENT_REQUESTS=3
TMAP_TRANSIT_CACHE_TTL_SECONDS=1800
TMAP_TRANSIT_TIMEOUT_SECONDS=12
TMAP_TRANSIT_MAX_CANDIDATES=10
TMAP_TRANSIT_MAX_CONCURRENT_REQUESTS=3
# 휠체어 profile의 노면·폭·턱·경사·계단 제한 검증에 사용합니다.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_CACHE_TTL_SECONDS=1800
ORS_TIMEOUT_SECONDS=20
ORS_MAX_CONCURRENT_REQUESTS=3
# true이면 준비된 ai/data/cache/osmnx/busan-walk.graphml을 보행 geometry fallback으로 사용합니다.
OSMNX_WALK_GEOMETRY_ENABLED=false
OSMNX_OVERPASS_URL=https://lambert.openstreetmap.de/api
OSMNX_REQUEST_TIMEOUT_SECONDS=12
OSMNX_WALK_GEOMETRY_TIMEOUT_SECONDS=15
# human_validated(기본) 또는 명시적 비교용 bootstrap_baseline
# 초기 AI 기반 추천 기준선입니다. 사람 평가 완료·접근성 보장을 뜻하지 않습니다.
RANKER_TIER=bootstrap_baseline
VWORLD_API_KEY=
VWORLD_CACHE_TTL_HOURS=168
SHADE_CACHE_TTL_SECONDS=86400
OPENWEATHER_API_KEY=
BUS_SERVICE_KEY=

# 아래 4개는 준비 스크립트가 안전한 난수로 자동 생성합니다.
POSTGRES_PASSWORD=
SESSION_SECRET=
TRAINING_ANONYMIZATION_SALT=
LABELING_API_TOKEN=

# 필요할 때만 조정
REQUEST_TIMEOUT=8
WEATHER_CACHE_TTL_SECONDS=300
# 그늘 계산이 현재 날씨 관측을 유효하다고 볼 시간 창(초, 0=판정 불가).
# 관측 나이와 출발시각 차이에 모두 적용한다. 위 캐시 수명과는 다른 값이다.
SHADE_WEATHER_OBSERVATION_VALIDITY_SECONDS=3600
MAX_SUPPORTED_TOTAL_WALK_M=15000
# 요청 body에 topN이 없을 때 적용하는 운영 기본 추천 후보 수(1~10).
# 변경은 서비스 재시작 후 새 검색부터 적용되며 기존 route-set에는 소급되지 않습니다.
ROUTE_DEFAULT_TOP_N=5

# Backend와 AI가 공유하는 내부 API 인증 토큰(최소 32자)
AI_INTERNAL_SERVICE_TOKEN=

# 임시 LLM 공급자: NVIDIA API Catalog 호스팅 NIM(OpenAI 호환 API).
# 키와 모델명은 Backend만 사용하며, 프론트엔드 번들·VITE_ 변수에 넣지 않습니다.
# 모델은 Build 페이지의 실제 model ID를 지정합니다.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NIM_REQUEST_TIMEOUT_SECONDS=30
NIM_MAX_OUTPUT_TOKENS=800
# 빈 NIM 본문만 재시도하는 횟수와, 추천 응답에서 음성 요약을 보강할 최대 경로 수
NIM_RESPONSE_ATTEMPTS=2
NIM_ROUTE_EXPLANATION_MAX_ROUTES=3
