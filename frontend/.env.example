# Kakao Map JavaScript 키 (없으면 데모 약도임을 표시한 패널 사용)
# https://developers.kakao.com -> 내 애플리케이션 -> JavaScript 키
VITE_KAKAO_MAP_KEY=

# 데이터 소스 모드: mock | live
# 일반 개발은 live이며 mock은 명시적인 UI 단위 테스트에서만 선택합니다.
VITE_DATA_SOURCE=live

# 브라우저 요청은 같은 origin /api를 사용합니다.
VITE_API_BASE=

# Vite 개발 서버가 /api를 전달할 현재 로컬 통합 스택입니다.
VITE_DEV_PROXY_TARGET=http://localhost:8080
