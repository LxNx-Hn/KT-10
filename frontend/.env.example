# Kakao Map JavaScript 키 (없으면 데모 약도임을 표시한 패널 사용)
# https://developers.kakao.com -> 내 애플리케이션 -> JavaScript 키
VITE_KAKAO_MAP_KEY=

# 데이터 소스 모드: mock | live
# live = Python FastAPI 백엔드(backend/)에 연결
VITE_DATA_SOURCE=mock

# live 모드일 때 백엔드 베이스 URL (기본 http://localhost:8002)
VITE_API_BASE=http://localhost:8002
