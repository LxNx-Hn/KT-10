{
  "name": "barrier-free-route-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "부산 전역 교통약자·이동취약자 맞춤형 접근성 경로 추천 PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:places": "playwright test e2e/live-place-search.spec.ts",
    "test:e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "validate": "vitest run src/scoring/validation",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ejs": "5.0.1"
  }
}
